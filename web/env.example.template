# Coloca a tua OPENAI_API_KEY abaixo. Opcional: cp .env.example .env
# O servidor carrega .env.example e, se existir, sobrescreve com .env
# =============================================================================

# ⚠️ Substitui pela chave REAL (https://platform.openai.com/api-keys) — não deixes o texto de exemplo
OPENAI_API_KEY=

# Chat (catálogo + agente de campanhas / prompts)
OPENAI_MODEL=gpt-4o

# --- Imagens do produto: 4 criativos (GPT Image) ---
# Modelo de imagem (edit/generate com foto do produto)
CAMPAIGN_IMAGE_MODEL=gpt-image-1
# Qualidade: low | medium | high | auto
CAMPAIGN_IMAGE_QUALITY=high
# GPT que vê a foto + chama image_generation (Responses API)
CAMPAIGN_GPT_MODEL=gpt-4o

PORT=3001

