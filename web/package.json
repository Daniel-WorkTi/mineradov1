{
  "name": "miner-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "python3 ../scripts/prepare-dashboard-data.py",
    "server": "node server/index.mjs",
    "dev": "npm run prepare-data && concurrently -n api,web -c yellow,cyan \"npm run server\" \"vite\"",
    "dev:web": "npm run prepare-data && vite",
    "build": "npm run prepare-data && tsc -b && vite build",
    "build:vercel": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/react": "^2.8.9",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.525.0",
    "openai": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@heroui/theme": "^2.4.26",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
